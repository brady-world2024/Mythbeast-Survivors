[gd_scene format=3]

[ext_resource type="Script" path="res://ui/components/permanent_upgrade_card.gd" id="1_card"]

[node name="PermanentUpgradeCard" type="PanelContainer"]
script = ExtResource("1_card")

[node name="Contents" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Header" type="HBoxContainer" parent="Contents"]
layout_mode = 2
theme_override_constants/separation = 11

[node name="UpgradeIcon" type="TextureRect" parent="Contents/Header"]
