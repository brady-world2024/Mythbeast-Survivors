[gd_scene format=3]

[ext_resource type="Script" path="res://core/app/app.gd" id="1_app"]
[ext_resource type="AudioStream" path="res://assets/audio/grove_theme.wav" id="2_music"]
[ext_resource type="AudioStream" path="res://assets/audio/tap.wav" id="3_tap"]

[node name="App" type="Node"]
script = ExtResource("1_app")

[node name="ScreenHost" type="Node" parent="."]

[node name="Music" type="AudioStreamPlayer" parent="."]
stream = ExtResource("2_music")
bus = &"Music"

[node name="Tap" type="AudioStreamPlayer" parent="."]
process_mode = 3
stream = ExtResource("3_tap")
bus = &"SFX"
